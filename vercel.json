{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm run build",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "buildCommand": "npm run build",
      "rewrites": [
        {
          "source": "/services",
          "destination": "/seo-pages/services.html"
        },
        {
          "source": "/supplies",
          "destination": "/seo-pages/supplies.html"
        },
        {
          "source": "/it-services",
          "destination": "/seo-pages/it-services.html"
        },
        {
          "source": "/industries",
          "destination": "/seo-pages/industries.html"
        },
        {
          "source": "/blog",
          "destination": "/seo-pages/blog.html"
        },
        {
          "source": "/clients",
          "destination": "/seo-pages/clients.html"
        },
        {
          "source": "/contact",
          "destination": "/seo-pages/contact.html"
        },
        {
          "source": "/services/engineering-consultancy",
          "destination": "/seo-pages/services/engineering-consultancy.html"
        },
        {
          "source": "/services/civil-engineering",
          "destination": "/seo-pages/services/civil-engineering.html"
        },
        {
          "source": "/services/mechanical-engineering",
          "destination": "/seo-pages/services/mechanical-engineering.html"
        },
        {
          "source": "/services/peb-works",
          "destination": "/seo-pages/services/peb-works.html"
        },
        {
          "source": "/services/electrical-works",
          "destination": "/seo-pages/services/electrical-works.html"
        },
        {
          "source": "/services/mechanical-electrical-supplies",
          "destination": "/seo-pages/services/mechanical-electrical-supplies.html"
        },
        {
          "source": "/services/utilities-facility-maintenance",
          "destination": "/seo-pages/services/utilities-facility-maintenance.html"
        },
        {
          "source": "/services/boiler-chemicals",
          "destination": "/seo-pages/services/boiler-chemicals.html"
        },
        {
          "source": "/services/seamless-pipes-fittings",
          "destination": "/seo-pages/services/seamless-pipes-fittings.html"
        },
        {
          "source": "/services/wastewater-treatment-plant",
          "destination": "/seo-pages/services/wastewater-treatment-plant.html"
        },
        {
          "source": "/services/hvac-supplies-services",
          "destination": "/seo-pages/services/hvac-supplies-services.html"
        },
        {
          "source": "/services/fire-fighting-equipment",
          "destination": "/seo-pages/services/fire-fighting-equipment.html"
        },
        {
          "source": "/services/safety-security-systems",
          "destination": "/seo-pages/services/safety-security-systems.html"
        },
        {
          "source": "/services/waterproofing-solutions",
          "destination": "/seo-pages/services/waterproofing-solutions.html"
        },
        {
          "source": "/services/pumps-valves-pneumatic",
          "destination": "/seo-pages/services/pumps-valves-pneumatic.html"
        },
        {
          "source": "/blog/prepare-a-general-order-supply-request",
          "destination": "/seo-pages/blog/prepare-a-general-order-supply-request.html"
        },
        {
          "source": "/blog/industrial-maintenance-supplier-checklist",
          "destination": "/seo-pages/blog/industrial-maintenance-supplier-checklist.html"
        },
        {
          "source": "/blog/hvac-preventive-maintenance-checklist",
          "destination": "/seo-pages/blog/hvac-preventive-maintenance-checklist.html"
        },
        {
          "source": "/blog/peb-project-planning-checklist",
          "destination": "/seo-pages/blog/peb-project-planning-checklist.html"
        },
        {
          "source": "/blog/fire-safety-equipment-site-planning",
          "destination": "/seo-pages/blog/fire-safety-equipment-site-planning.html"
        },
        {
          "source": "/blog/industrial-electrical-maintenance-checklist",
          "destination": "/seo-pages/blog/industrial-electrical-maintenance-checklist.html"
        },
        {
          "source": "/blog/industrial-spare-parts-inventory-planning",
          "destination": "/seo-pages/blog/industrial-spare-parts-inventory-planning.html"
        },
        {
          "source": "/blog/compare-industrial-supplier-quotations",
          "destination": "/seo-pages/blog/compare-industrial-supplier-quotations.html"
        },
        {
          "source": "/admin",
          "destination": "/seo-pages/admin.html"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/services/pumps-valves-pneumatic-fittings",
          "destination": "/services/pumps-valves-pneumatic",
          "permanent": true
        },
        {
          "source": "/services/mechanical-electrical-supplies-services",
          "destination": "/services/mechanical-electrical-supplies",
          "permanent": true
        },
        {
          "source": "/clients.html",
          "destination": "/clients",
          "permanent": true
        },
        {
          "source": "/insights",
          "destination": "/blog",
          "permanent": true
        },
        {
          "source": "/insights/:path*",
          "destination": "/blog/:path*",
          "permanent": true
        },
        {
          "source": "/services/hvac",
          "destination": "/services/hvac-supplies-services",
          "permanent": true
        },
        {
          "source": "/services/fire-fighting",
          "destination": "/services/fire-fighting-equipment",
          "permanent": true
        }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "secure_main:app"
    }
  },
  "headers": [
    {
      "source": "/images/optimized/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/local/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/static/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/media/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https:; frame-src 'self' https://www.google.com https://maps.google.com; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
